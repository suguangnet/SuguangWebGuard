# 运行时生成的文件，不应进入版本库
# 注意：.gitignore 不支持行尾注释，注释必须独占一行，
#       否则整行（含注释）会被当成文件名，规则静默失效。
# 站点配置由 install.sh 生成，模板见 exclude.conf.example
exclude.conf
exclude.conf.bak.*
# 含密码哈希
web.conf
web-initial-password.txt
# 含登录会话令牌
sessions.json
sessions.json.tmp
.maintenance
# 由 aide-init.sh 自动生成
aide.conf
aide.db.gz
aide.db.new.gz
logs/
quarantine/

# Python
__pycache__/
*.pyc

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
