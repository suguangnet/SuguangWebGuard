# 全部脚本与配置强制 LF —— 这些文件要在 Linux 上执行，
# 若在 Windows 检出成 CRLF 会导致 "bad interpreter: /bin/bash^M" 之类错误
*           text=auto eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.example   text eol=lf
*.html      text eol=lf
*.md        text eol=lf
cron.*      text eol=lf
logrotate.* text eol=lf
